<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <AssemblyName>RealAtmospheres</AssemblyName>
    <RootNamespace>RealAtmospheres</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- StarMap loader folder: provides StarMap.API + 0Harmony at build time. Borea keeps its own
         copy of the loader; fall back to a standalone StarMap launcher install if Borea is absent. -->
    <StarMapDir Condition="'$(StarMapDir)' == '' And Exists('$(LOCALAPPDATA)\Borea\Loaders\StarMap\StarMap.API.dll')">$(LOCALAPPDATA)\Borea\Loaders\StarMap</StarMapDir>
    <StarMapDir Condition="'$(StarMapDir)' == ''">$(USERPROFILE)\Documents\StarMapLauncher-0.4.5</StarMapDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cooperative shared-shadow coordinator, shared with the Real Surfaces mod. In the dev tree it
         is compiled from the sibling Shared\ folder; a standalone clone falls back to the mirror in
         this repository (keep the two in sync). -->
    <Compile Remove="Shared\**" />
    <Compile Include="..\Shared\SharedShadow.cs" Link="SharedShadow.cs" Condition="Exists('..\Shared\SharedShadow.cs')" />
    <Compile Include="Shared\SharedShadow.cs" Link="SharedShadow.cs" Condition="!Exists('..\Shared\SharedShadow.cs')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="StarMap.API">
      <HintPath>$(StarMapDir)\StarMap.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(StarMapDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
